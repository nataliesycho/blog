---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIALS } from "../config";
---

<BaseLayout title="About" description="A little about me.">
  <div class="prose">
    <h1>About</h1>
    <p>
      Hi — I'm Natalie. I'm a <em>[what you do]</em> based in
      <em>[where you are]</em>. I started this site to write down the ideas I
      keep coming back to: what I'm learning, what I'm building, and the
      questions I don't have clean answers to yet.
    </p>
    <p>
      Most of my writing lives on the <a href="/writing">writing</a> page. If
      something resonates, I'd love to hear from you.
    </p>

    <h2>Elsewhere</h2>
    <ul>
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.href}>{s.label}</a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
